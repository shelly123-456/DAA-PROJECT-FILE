import tkinter as tk

def fast_power():
    a = int(base_entry.get())
    b = int(exp_entry.get())
    result = 1

    while b > 0:
        if b % 2 == 1:
            result *= a
        a *= a
        b //= 2

    result_label.config(text="Result = " + str(result))

root = tk.Tk()
root.title("Fast Exponentiation")
root.geometry("300x250")

tk.Label(root, text="Enter Base:").pack()
base_entry = tk.Entry(root)
base_entry.pack()

tk.Label(root, text="Enter Exponent:").pack()
exp_entry = tk.Entry(root)
exp_entry.pack()

tk.Button(root, text="Calculate", command=fast_power).pack()

result_label = tk.Label(root, text="Result = ")
result_label.pack()

root.mainloop()
