#include <stdio.h>

int main() {
    int a, b, result = 1;

    printf("Enter base and exponent: ");
    scanf("%d %d", &a, &b);

    while (b > 0) {
        if (b % 2 == 1)
            result = result * a;

        a = a * a;
        b = b / 2;
    }

    printf("Result = %d", result);

    return 0;
}
